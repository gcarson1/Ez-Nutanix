{
  "name": "nutanix-architecture-explorer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Single-file interactive explainer of the Nutanix platform for live customer presentations.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-preact": "^1.61.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
